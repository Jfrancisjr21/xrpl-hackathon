{
  "name": "xrpl-lending",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "pnpm --parallel --filter @hack/api --filter @hack/web dev",
    "dev:api": "pnpm --filter @hack/api dev",
    "dev:web": "pnpm --filter @hack/web dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "smoke": "bash scripts/smoke.sh",
    "ledger:fund-wallets": "pnpm --filter @hack/ledger fund-wallets",
    "ledger:check-wallets": "pnpm --filter @hack/ledger check-wallets",
    "ledger:bootstrap": "pnpm --filter @hack/ledger bootstrap",
    "ledger:new-vault": "pnpm --filter @hack/ledger new-vault",
    "ledger:lifecycle": "pnpm --filter @hack/ledger lifecycle",
    "ledger:score-token": "pnpm --filter @hack/ledger score-token"
  }
}